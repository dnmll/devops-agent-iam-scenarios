{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ExampleRebootTaggedInstances",
      "Effect": "Allow",
      "Action": "ec2:RebootInstances",
      "Resource": "arn:aws:ec2:us-east-1:111122223333:instance/*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/DevOpsAgentRemediation": "allowed"
        }
      }
    },
    {
      "Sid": "ExampleReconfigureTaggedFunctions",
      "Effect": "Allow",
      "Action": "lambda:UpdateFunctionConfiguration",
      "Resource": "arn:aws:lambda:us-east-1:111122223333:function:*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/DevOpsAgentRemediation": "allowed"
        }
      }
    }
  ]
}
