{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowDevOpsAgentServiceFromMonitoringAccountToAssumeThisRole",
      "Effect": "Allow",
      "Principal": {
        "Service": "aidevops.amazonaws.com"
      },
      "Action": "sts:AssumeRole",
      "Condition": {
        "StringEquals": {
          "aws:SourceAccount": "222233334444"
        },
        "ArnLike": {
          "aws:SourceArn": "arn:aws:aidevops:us-east-1:222233334444:agentspace/*"
        }
      }
    }
  ]
}
