{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CreateResourceExplorerServiceLinkedRoleInThisMemberAccount",
      "Effect": "Allow",
      "Action": "iam:CreateServiceLinkedRole",
      "Resource": "arn:aws:iam::111122223333:role/aws-service-role/resource-explorer-2.amazonaws.com/AWSServiceRoleForResourceExplorer",
      "Condition": {
        "StringEquals": {
          "iam:AWSServiceName": "resource-explorer-2.amazonaws.com"
        }
      }
    }
  ]
}
